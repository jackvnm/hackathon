# Optional: defaults to backend/data. Keep local records and photos out of Git.
# CIVIC_DATA_DIR=/absolute/path/to/local/data
CIVIC_CORS_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Fixed depot and road-travel provider used by POST /api/plan.
CIVIC_DEPOT_LAT=53.34
CIVIC_DEPOT_LNG=-6.26
CIVIC_OSRM_URL=https://router.project-osrm.org
CIVIC_OSRM_TIMEOUT_SECONDS=15
